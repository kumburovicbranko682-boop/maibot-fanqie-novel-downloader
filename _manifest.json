  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/kumburovicbranko682-boop/maibot-fanqie-novel-downloader",
    "homepage": "https://github.com/kumburovicbranko682-boop/maibot-fanqie-novel-downloader",
    "documentation": "https://github.com/kumburovicbranko682-boop/maibot-fanqie-novel-downloader#readme",
